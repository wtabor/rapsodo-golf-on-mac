# shellcheck shell=bash disable=SC2034
# Copy to scripts/env.local.sh (gitignored) and edit. Sourced by scripts/env.sh.

# Your location for the Rapsodo games (decimal degrees, meters above sea level).
RGM_GEO_LAT=40.7128
RGM_GEO_LON=-74.0060
RGM_GEO_ALT=10

# Auto-update on each launch (scripts/update.sh). 0 turns it off; then update by
# running the install command again.
# RGM_AUTO_UPDATE=0
